# .env.example — Conference Management Platform (confhub)
# Copy to .env and fill in values. Never commit .env to git.
#
# ⚠ Secrets marked with [SECRET] must be changed in production.
# Generate secure randoms with: openssl rand -base64 32

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Prisma-compatible PostgreSQL connection string
DATABASE_URL="postgresql://confhub:confhub_secret@localhost:5432/confhub_dev"
# Separate URL for test DB (used by Vitest integration tests)
DATABASE_URL_TEST="postgresql://confhub:confhub_secret@localhost:5432/confhub_test"

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── STORAGE (S3-compatible) ─────────────────────────────────────────────────
# Local dev: MinIO running via docker-compose
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="confhub_minio"
S3_SECRET_ACCESS_KEY="confhub_minio_secret"  # [SECRET]
S3_BUCKET_NAME="confhub"
# Public URL for accessing uploaded files (used in response URLs)
S3_PUBLIC_URL="http://localhost:9000/confhub"
# Force path-style (required for MinIO self-hosted)
S3_FORCE_PATH_STYLE="true"

# ─── AUTH ────────────────────────────────────────────────────────────────────
# [SECRET] min 32 chars — generate: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARACTERS_LONG"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_MINIMUM_32_CHARACTERS_LONG"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Cookie name — MUST remain __Host- prefix (enforces Secure + no Domain + Path=/)
JWT_REFRESH_COOKIE_NAME="__Host-refresh"

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────
# Local dev: Mailhog (http://localhost:8025 to view sent emails)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Conference Platform"
SMTP_FROM_EMAIL="noreply@localhost"
# Max concurrent email sending connections
SMTP_POOL_SIZE="5"

# ─── APP URLS ────────────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:5173"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"
# Used in email links (must be public-facing URL in production)
PUBLIC_BASE_URL="http://localhost:5173"

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT="3001"
NODE_ENV="development"
LOG_LEVEL="info"
# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT="30000"

# ─── SENTRY ──────────────────────────────────────────────────────────────────
# Leave empty to disable Sentry
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ─── SSE (Server-Sent Events) ────────────────────────────────────────────────
# Heartbeat interval for SSE connections (ms)
SSE_HEARTBEAT_INTERVAL="25000"
# Max SSE connections per instance (prevents memory leak)
SSE_MAX_CONNECTIONS="1000"

# ─── PLUGIN SYSTEM ───────────────────────────────────────────────────────────
# Comma-separated list of enabled plugin names (from /plugins directory)
PLUGINS_ENABLED="slack,social-card"
# Directory for external (community) plugins
PLUGINS_EXTERNAL_DIR=""

# ─── BUILT-IN PLUGIN: SLACK ──────────────────────────────────────────────────
# Default webhook URL (can be overridden per-event in event_integrations)
# Leave empty to require per-event configuration
SLACK_DEFAULT_WEBHOOK_URL=""

# ─── BUILT-IN PLUGIN: SOCIAL CARD ────────────────────────────────────────────
# Path to fonts for Satori card generation
SOCIAL_CARD_FONTS_DIR="./packages/shared/assets/fonts"
# Cache TTL for generated cards (seconds)
SOCIAL_CARD_CACHE_TTL="86400"

# ─── WORKER ──────────────────────────────────────────────────────────────────
# BullMQ worker concurrency per queue
WORKER_CONCURRENCY_EMAIL="5"
WORKER_CONCURRENCY_WEBHOOKS="10"
WORKER_CONCURRENCY_PLUGINS="3"
WORKER_CONCURRENCY_STATS="1"

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
# Requests per minute per IP for public endpoints
RATE_LIMIT_PUBLIC="100"
# Requests per minute per token for authenticated endpoints
RATE_LIMIT_AUTHENTICATED="1000"
# Auth endpoints (login, register, reset-password)
RATE_LIMIT_AUTH="10"

# ─── SOCIAL AUTH (SSO) ───────────────────────────────────────────────────────
# Google OAuth2
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""  # [SECRET]
# GitHub OAuth2
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""  # [SECRET]

# ─── FEATURE FLAGS ───────────────────────────────────────────────────────────
# These can be toggled without code deploy
FEATURE_PUBLIC_VOTING="true"
FEATURE_TRAVEL_MANAGEMENT="true"
FEATURE_EVENT_SERIES="true"

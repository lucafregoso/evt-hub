generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/generated"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  email String @unique
  role  String
}

model Event {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  description String
}

model Session {
  id      String @id @default(uuid())
  title   String
  eventId String
}

{
  "name": "confhub",
  "version": "0.1.0",
  "private": true,
  "description": "OSS Session Management Platform",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "prepare": "husky",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "prisma": "^7.8.0",
    "prisma-kysely": "^3.1.0",
    "turbo": "latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "kysely": "^0.29.0"
  }
}
